# App
NODE_ENV=development
PORT=5000

# MongoDB
MONGO_URI=mongodb://localhost:27017/creatorlane

# Redis
REDIS_URL=redis://localhost:6379

# RabbitMQ
RABBITMQ_URL=amqp://localhost

# JWT (must be at least 32 characters each)
JWT_ACCESS_SECRET=your_access_secret_here_minimum_32chars
JWT_REFRESH_SECRET=your_refresh_secret_here_minimum_32chars

# Cookie (must be at least 32 characters)
COOKIE_SECRET=your_cookie_secret_here_minimum_32chars

# CORS (comma-separated list of allowed origins)
ALLOWED_ORIGINS=http://localhost:3000

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=app_password_here
SMTP_FROM="CreatorLane <noreply@creatorlane.in>"
